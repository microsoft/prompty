{
  "description": "Cross-runtime model-discovery vectors. Each vector asserts that a raw provider response object maps to the canonical, Typra-generated ModelInfo shape (camelCase field names as emitted by ModelInfo.to_value / toValue). This is the provider wire -> ModelInfo mapping contract every runtime MUST satisfy. Capability enrichment from a built-in known-model table is provider-OPTIONAL per the ModelInfo contract, so OpenAI vectors intentionally use ids outside any enrichment table to isolate the pure wire mapping. 'provider' selects which runtime crate maps the vector; 'shape' disambiguates the Foundry endpoints (deployment vs catalog).",
  "vectors": [
    {
      "name": "openai_model_basic",
      "provider": "openai",
      "shape": "model",
      "input": {
        "id": "o3-mini",
        "object": "model",
        "created": 1715367049,
        "owned_by": "system"
      },
      "expected": {
        "id": "o3-mini",
        "ownedBy": "system",
        "additionalProperties": {
          "id": "o3-mini",
          "object": "model",
          "created": 1715367049,
          "owned_by": "system"
        }
      }
    },
    {
      "name": "openai_model_finetune_no_owner",
      "provider": "openai",
      "shape": "model",
      "input": {
        "id": "ft:custom-model:acme::xyz"
      },
      "expected": {
        "id": "ft:custom-model:acme::xyz",
        "additionalProperties": {
          "id": "ft:custom-model:acme::xyz"
        }
      }
    },
    {
      "name": "anthropic_model_full",
      "provider": "anthropic",
      "shape": "model",
      "input": {
        "id": "claude-sonnet-4-20250514",
        "display_name": "Claude Sonnet 4",
        "context_length": 200000,
        "input_modalities": ["text", "image"],
        "output_modalities": ["text"],
        "type": "model"
      },
      "expected": {
        "id": "claude-sonnet-4-20250514",
        "displayName": "Claude Sonnet 4",
        "ownedBy": "anthropic",
        "contextWindow": 200000,
        "inputModalities": ["text", "image"],
        "outputModalities": ["text"],
        "additionalProperties": {
          "id": "claude-sonnet-4-20250514",
          "display_name": "Claude Sonnet 4",
          "context_length": 200000,
          "input_modalities": ["text", "image"],
          "output_modalities": ["text"],
          "type": "model"
        }
      }
    },
    {
      "name": "anthropic_model_minimal",
      "provider": "anthropic",
      "shape": "model",
      "input": {
        "id": "claude-3-haiku-20240307",
        "type": "model"
      },
      "expected": {
        "id": "claude-3-haiku-20240307",
        "ownedBy": "anthropic",
        "additionalProperties": {
          "id": "claude-3-haiku-20240307",
          "type": "model"
        }
      }
    },
    {
      "name": "foundry_deployment_flat_v1",
      "provider": "foundry",
      "shape": "deployment",
      "input": {
        "name": "gpt-4o",
        "type": "ModelDeployment",
        "modelName": "gpt-4o",
        "modelVersion": "2024-08-06",
        "modelPublisher": "OpenAI",
        "capabilities": {
          "chatCompletion": "true"
        },
        "sku": {
          "name": "GlobalStandard",
          "capacity": 50
        }
      },
      "expected": {
        "id": "gpt-4o",
        "displayName": "gpt-4o",
        "ownedBy": "OpenAI",
        "additionalProperties": {
          "name": "gpt-4o",
          "type": "ModelDeployment",
          "modelName": "gpt-4o",
          "modelVersion": "2024-08-06",
          "modelPublisher": "OpenAI",
          "capabilities": {
            "chatCompletion": "true"
          },
          "sku": {
            "name": "GlobalStandard",
            "capacity": 50
          }
        }
      }
    },
    {
      "name": "foundry_deployment_nested_arm",
      "provider": "foundry",
      "shape": "deployment",
      "input": {
        "name": "my-gpt4",
        "properties": {
          "model": {
            "name": "gpt-4",
            "publisher": "OpenAI",
            "maxContextLength": 8192
          },
          "capabilities": {
            "supportedInputModalities": ["text"],
            "supportedOutputModalities": ["text"]
          }
        }
      },
      "expected": {
        "id": "my-gpt4",
        "displayName": "gpt-4",
        "ownedBy": "OpenAI",
        "contextWindow": 8192,
        "inputModalities": ["text"],
        "outputModalities": ["text"],
        "additionalProperties": {
          "name": "my-gpt4",
          "properties": {
            "model": {
              "name": "gpt-4",
              "publisher": "OpenAI",
              "maxContextLength": 8192
            },
            "capabilities": {
              "supportedInputModalities": ["text"],
              "supportedOutputModalities": ["text"]
            }
          }
        }
      }
    },
    {
      "name": "foundry_catalog_model",
      "provider": "foundry",
      "shape": "catalog",
      "input": {
        "id": "gpt-4",
        "owned_by": "openai",
        "maxContextLength": 8192,
        "status": "succeeded"
      },
      "expected": {
        "id": "gpt-4",
        "ownedBy": "openai",
        "contextWindow": 8192,
        "additionalProperties": {
          "id": "gpt-4",
          "owned_by": "openai",
          "maxContextLength": 8192,
          "status": "succeeded"
        }
      }
    }
  ]
}
