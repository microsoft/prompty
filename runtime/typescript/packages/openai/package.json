{
  "name": "@prompty/openai",
  "version": "2.0.0-beta.5",
  "description": "OpenAI provider for Prompty — executor and processor for OpenAI APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prompty",
    "openai",
    "llm",
    "ai"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/prompty.git",
    "directory": "runtime/typescript/packages/openai"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@prompty/core": "^2.0.0-beta.4"
  },
  "dependencies": {
    "@prompty/core": "^2.0.0-beta.4",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@prompty/core": "^2.0.0-beta.5",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
